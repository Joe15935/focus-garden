{
  "productName": "Focus Garden",
  "identifier": "org.focusgarden.local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "./frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "专注花园",
        "width": 1180,
        "height": 800,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "externalBin": [],
    "resources": {
      "../../THIRD_PARTY_NOTICES": "THIRD_PARTY_NOTICES",
      "../../LICENSE": "LICENSE",
      "../../docs/licenses/": "docs/licenses/",
      "../../docs/使用说明.md": "docs/使用说明.md",
      "../../docs/数据与恢复.md": "docs/数据与恢复.md"
    },
    "copyright": "Focuser Contributors; Focus Garden Contributors",
    "shortDescription": "本地专注与成长花园",
    "longDescription": "完全本地的中文专注花园，复用开源规则引擎与 macOS 原生能力。",
    "windows": {
      "nsis": {
        "installMode": "both",
        "startMenuFolder": "Focuser",
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "sidebarImage": null,
        "installerHooks": "nsis/installer-hooks.nsi"
      },
      "wix": null
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libappindicator3-1"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {},
  "version": "0.1.0"
}
