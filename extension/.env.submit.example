# Legacy upstream extension template; replace every placeholder before use.
# Focus Garden macOS does not use this extension or require store credentials.
# Copy to `.env.submit` and fill in. That file is gitignored by `.env.*`.
#
# `publish-extension init` (5.1.0) cannot bootstrap from nothing: it fabricates
# a zip for every store, which makes validation demand every credential before
# it will prompt for any of them. Starting from this file, with placeholders
# in place, gets past that and lets `init` generate the Chrome refresh token.

# ─── Chrome Web Store ─────────────────────────────────────────────────
# Extension id: from the URL in the developer dashboard.
CHROME_EXTENSION_ID=YOUR_CHROME_EXTENSION_ID
# OAuth client of type "Desktop app", from the Google Cloud console.
CHROME_CLIENT_ID=YOUR_CHROME_CLIENT_ID
CHROME_CLIENT_SECRET=YOUR_CHROME_CLIENT_SECRET
# Generated by `npx publish-extension init` once the three above are real.
CHROME_REFRESH_TOKEN=YOUR_CHROME_REFRESH_TOKEN

# ─── Firefox Add-ons ──────────────────────────────────────────────────
FIREFOX_EXTENSION_ID=YOUR_FIREFOX_EXTENSION_ID
# addons.mozilla.org → Developer Hub → Manage API Keys.
FIREFOX_JWT_ISSUER=YOUR_FIREFOX_JWT_ISSUER
FIREFOX_JWT_SECRET=YOUR_FIREFOX_JWT_SECRET

# ─── Stores we do not publish to ──────────────────────────────────────
# Only here because `init` insists every store validates before it runs.
# Leave them alone; nothing is submitted without a zip for that store.
EDGE_PRODUCT_ID=YOUR_EDGE_PRODUCT_ID
EDGE_CLIENT_ID=YOUR_EDGE_CLIENT_ID
EDGE_API_KEY=YOUR_EDGE_API_KEY
OPERA_PACKAGE_ID=YOUR_OPERA_PACKAGE_ID
OPERA_SESSION_ID=YOUR_OPERA_SESSION_ID
